
# BRIELLE SKINCARE WEBSITE
# Files and folders Git should ignore

# Installed dependencies
node_modules/

# Production build files
dist/
dist-ssr/

# Local environment variables and secret keys
.env
.env.local
.env.*.local

# Netlify generated files
.netlify/

# Debug and error logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system files
.DS_Store
Thumbs.db

# Editor settings
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.bak
